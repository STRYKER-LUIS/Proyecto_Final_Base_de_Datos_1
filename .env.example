# ---------------------------------------------------------------------------
# Mini IDE · Base de Datos 1 — configuración de ejemplo
# Copia este archivo como ".env" y ajusta los valores a tu entorno.
# ---------------------------------------------------------------------------

# Servidor web
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false
# Orígenes permitidos para CORS, separados por coma. Usa * solo en desarrollo.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Valores que el frontend precarga en el formulario de PostgreSQL.
# La contraseña NUNCA se envía al navegador: se escribe en la interfaz.
# ---------------------------------------------------------------------------
SQL_DEFAULT_HOST=localhost
SQL_DEFAULT_PORT=5432
SQL_DEFAULT_USER=postgres
SQL_DEFAULT_DB=postgres

# ---------------------------------------------------------------------------
# Valores que el frontend precarga en el formulario de MongoDB.
# ---------------------------------------------------------------------------
MONGO_DEFAULT_URI=mongodb://localhost:27017
MONGO_DEFAULT_DB=mini_ide_bd1

# ---------------------------------------------------------------------------
# Límites de seguridad para no saturar la interfaz.
# ---------------------------------------------------------------------------
SQL_RESULT_LIMIT=1000
MONGO_RESULT_LIMIT=100
